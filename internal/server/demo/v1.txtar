import React from 'react'
import ReactDOM from 'react-dom/client'
import { BrowserRouter } from 'react-router-dom'
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
import App from './App'

const queryClient = new QueryClient()

ReactDOM.createRoot(document.getElementById('root')!).render(
  <React.StrictMode>
    <QueryClientProvider client={queryClient}>
      <BrowserRouter><App /></BrowserRouter>
    </QueryClientProvider>
  </React.StrictMode>,
)
-- web/src/App.tsx --
import { Route, Routes } from 'react-router-dom'
import { Header } from '@/components/Header'
import Products from '@/pages/Products'
import Cart from '@/pages/Cart'
import Orders from '@/pages/Orders'

export default function App() {
  return (
    <>
      <Header />
      <Routes>
        <Route path="/" element={<Products />} />
        <Route path="/cart" element={<Cart />} />
        <Route path="/orders" element={<Orders />} />
      </Routes>
    </>
  )
}
-- web/src/api/client.ts --
// Talks to the shop API.
export interface Product { id: number; name: string; description: string; price_cents: number; stock: number }
export interface OrderItem { product_id: number; quantity: number }
export interface Order { id: number; status: string; total_cents: number; items: OrderItem[] }

const BASE = import.meta.env.VITE_API_URL || '/api/v1'

async function request<T>(method: string, path: string, body?: unknown): Promise<T> {
  const res = await fetch(BASE + path, {
    method,
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${localStorage.getItem('token') || ''}` },
    body: body === undefined ? undefined : JSON.stringify(body),
  })
  if (!res.ok) throw new Error((await res.json()).error || res.statusText)
  return res.status === 204 ? (undefined as T) : res.json()
}

export const listProducts = (q = '') => request<Product[]>('GET', `/products?q=${encodeURIComponent(q)}`)
export const getProduct = (id: number) => request<Product>('GET', `/products/${id}`)
export const listOrders = () => request<Order[]>('GET', '/orders')
export const createOrder = (items: OrderItem[]) => request<Order>('POST', '/orders', { items })
export const cancelOrder = (id: number) => request<void>('POST', `/orders/${id}/cancel`)
-- web/src/hooks/useCart.ts --
import { useState } from 'react'
import type { OrderItem } from '@/api/client'

export function useCart() {
  const [items, setItems] = useState<OrderItem[]>(() => JSON.parse(localStorage.getItem('cart') || '[]'))
  const save = (next: OrderItem[]) => { setItems(next); localStorage.setItem('cart', JSON.stringify(next)) }
  const add = (productId: number) => {
    const found = items.find(i => i.product_id === productId)
    save(found ? items.map(i => i === found ? { ...i, quantity: i.quantity + 1 } : i) : [...items, { product_id: productId, quantity: 1 }])
  }
  const clear = () => save([])
  return { items, add, clear }
}
-- web/src/components/Header.tsx --
import { Link } from 'react-router-dom'
import { useCart } from '@/hooks/useCart'

export function Header() {
  const { items } = useCart()
  return (
    <header className="header">
      <Link to="/">Northwind</Link>
      <nav><Link to="/orders">Orders</Link> <Link to="/cart">Cart ({items.length})</Link></nav>
    </header>
  )
}
-- web/src/components/ProductCard.tsx --
import type { Product } from '@/api/client'
import { formatPrice } from '@/lib/money'

export function ProductCard({ product, onAdd }: { product: Product; onAdd: () => void }) {
  return (
    <article className="card">
      <h3>{product.name}</h3>
      <p>{product.description}</p>
      <strong>{formatPrice(product.price_cents)}</strong>
      <button disabled={product.stock === 0} onClick={onAdd}>{product.stock === 0 ? 'Sold out' : 'Add to cart'}</button>
    </article>
  )
}
-- web/src/lib/money.ts --
export function formatPrice(cents: number, currency = 'EUR') {
  return new Intl.NumberFormat(undefined, { style: 'currency', currency }).format(cents / 100)
}
-- web/src/pages/Products.tsx --
import { useQuery } from '@tanstack/react-query'
import { useState } from 'react'
import { listProducts } from '@/api/client'
import { ProductCard } from '@/components/ProductCard'
import { useCart } from '@/hooks/useCart'

export default function Products() {
  const [q, setQ] = useState('')
  const { data = [] } = useQuery({ queryKey: ['products', q], queryFn: () => listProducts(q) })
  const cart = useCart()
  return (
    <main>
      <input value={q} onChange={e => setQ(e.target.value)} placeholder="Search" />
      <div className="grid">{data.map(p => <ProductCard key={p.id} product={p} onAdd={() => cart.add(p.id)} />)}</div>
    </main>
  )
}
-- web/src/pages/Cart.tsx --
import { useNavigate } from 'react-router-dom'
import { createOrder } from '@/api/client'
import { useCart } from '@/hooks/useCart'

export default function Cart() {
  const cart = useCart()
  const navigate = useNavigate()
  const checkout = async () => { await createOrder(cart.items); cart.clear(); navigate('/orders') }
  return (
    <main>
      <h1>Your cart</h1>
      <ul>{cart.items.map(i => <li key={i.product_id}>#{i.product_id} × {i.quantity}</li>)}</ul>
      <button disabled={cart.items.length === 0} onClick={checkout}>Check out</button>
    </main>
  )
}
-- web/src/pages/Orders.tsx --
import { useQuery, useQueryClient } from '@tanstack/react-query'
import { cancelOrder, listOrders } from '@/api/client'
import { formatPrice } from '@/lib/money'

export default function Orders() {
  const qc = useQueryClient()
  const { data = [] } = useQuery({ queryKey: ['orders'], queryFn: listOrders })
  const cancel = async (id: number) => { await cancelOrder(id); qc.invalidateQueries({ queryKey: ['orders'] }) }
  return (
    <main>
      <h1>Orders</h1>
      {data.map(o => (
        <div key={o.id} className="order">
          #{o.id} · {o.status} · {formatPrice(o.total_cents)}
          {o.status === 'new' && <button onClick={() => cancel(o.id)}>Cancel</button>}
        </div>
      ))}
    </main>
  )
}
