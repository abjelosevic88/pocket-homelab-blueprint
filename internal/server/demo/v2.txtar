-- worker/app/__init__.py --
-- worker/app/main.py --
"""The worker: payment webhooks in, e-mails out."""
from fastapi import FastAPI

from .hooks import router as hooks_router
from .settings import settings

app = FastAPI(title="Northwind worker")
app.include_router(hooks_router)


@app.get("/health")
def health():
    return {"status": "ok", "queue": settings.redis_url}
-- worker/app/hooks.py --
"""Webhooks from the payment provider and the shop API."""
from fastapi import APIRouter, Request

from . import jobs

router = APIRouter(prefix="/hooks")


@router.post("/stripe")
async def stripe_event(request: Request):
    event = await request.json()
    if event.get("type") == "payment_intent.succeeded":
        jobs.enqueue("send_receipt", event["data"]["object"]["metadata"])
    return {"received": True}


@router.post("/orders/{order_id}/shipped")
def order_shipped(order_id: int):
    jobs.enqueue("send_shipping_mail", {"order_id": order_id})
    return {"queued": True}
-- worker/app/jobs.py --
"""A tiny job queue on Redis."""
import json
import os

import redis

from .emails import send_receipt, send_shipping_mail

_queue = redis.from_url(os.environ.get("REDIS_URL", "redis://localhost:6379"))

HANDLERS = {"send_receipt": send_receipt, "send_shipping_mail": send_shipping_mail}


def enqueue(name, payload):
    _queue.rpush("jobs", json.dumps({"name": name, "payload": payload}))


def run_forever():
    while True:
        _, raw = _queue.blpop("jobs")
        job = json.loads(raw)
        HANDLERS[job["name"]](**job["payload"])
-- worker/app/emails.py --
"""E-mails the worker sends."""
import os
import smtplib
from email.message import EmailMessage

SMTP_HOST = os.getenv("SMTP_HOST", "localhost")


def _send(to, subject, body):
    msg = EmailMessage()
    msg["To"], msg["Subject"], msg["From"] = to, subject, "shop@northwind.example"
    msg.set_content(body)
    with smtplib.SMTP(SMTP_HOST) as s:
        s.send_message(msg)


def send_receipt(order_id, email=""):
    _send(email, f"Receipt for order {order_id}", "Thank you for your order.")


def send_shipping_mail(order_id):
    # TODO: look up the customer's address in the shop API
    _send("", f"Order {order_id} is on its way", "Your order has shipped.")
-- worker/app/settings.py --
"""Settings from the environment."""
from pydantic_settings import BaseSettings


class Settings(BaseSettings):
    redis_url: str = "redis://localhost:6379"
    smtp_host: str = "localhost"


settings = Settings()
